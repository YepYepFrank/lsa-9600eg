#!/bin/bash
# 假 systemd-run：--unit <名> … -- <命令>：另起一个会话后台跑（不等），输出进 /fake/units/<名>.log，pid 进 .pid
unit=''
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    --unit) unit="$2"; shift ;;
    --unit=*) unit="${1#--unit=}" ;;
    --description | -p | --property) shift ;;
  esac
  shift
done
[ -n "$unit" ] || { echo 'systemd-run（假）：要 --unit' >&2; exit 1; }
mkdir -p /fake/units
if [ -f "/fake/units/$unit.pid" ] && kill -0 "$(cat "/fake/units/$unit.pid")" 2>/dev/null; then echo "Failed to start transient service unit: Unit $unit.service already exists." >&2; exit 1; fi
echo "$*" > "/fake/units/$unit.cmd"
setsid "$@" > "/fake/units/$unit.log" 2>&1 < /dev/null &
echo $! > "/fake/units/$unit.pid"

#!/bin/bash
# LSA-9600EG 升级入口（0.17.2）：子站主机的 upgrade-egs.sh 经 SSH 用专用账号 lsa-upg 调这里，只能做下面几件事 ——
# 子站拿到的不是能在 EG 上执行任意命令的账号，而是「交一个指定的安装文件给 EG 自己升级、查进度」的钥匙。
#
# install.sh --upgrade-key <子站公钥> 装它（root 所有、755，在 /usr/local/sbin/），并写：
#   authorized_keys：restrict,from="<子站地址>",command="sudo -n /usr/local/sbin/lsa-eg-upgrade \"$SSH_ORIGINAL_COMMAND\"" <公钥>
#   sudoers：lsa-upg ALL=(root) NOPASSWD: /usr/local/sbin/lsa-eg-upgrade
# 不管子站发什么，sshd 都只运行上面的 command=；子站发的命令行整句作为第 1 个参数传进来，这里自己解析，只认：
#   hello                       入口版本、EG 版本、可用空间、当前任务、正在做的别的维护（预检用）
#   put <sha256> <字节数>        从 stdin 收安装文件到 /var/lib/lsa-upg/incoming/<sha256>.run：先查空间，收完核对字节数与 sha256，不对就删
#   start <sha256>              核对后开始升级（后台任务，SSH 断了照跑）：文件在、sha256 对、是 LSA 的一键安装文件（带 EG 发布件）、版本不比现在的低；
#                               同时只跑一个
#   status                      当前 / 最近一次任务的状态（key=value）
#   log [行数]                  任务日志最后几行（缺省 50，最多 500）
#   drop <sha256>               删掉收到的安装文件
# 一键加柜（0.17.4，子站 join-egs.sh 用）：
#   put-config <sha256> <字节数>  从 stdin 收配置包（tar.gz，≤ 1 MB）到 /var/lib/lsa-upg/config-in/<sha256>.tgz（600）：
#                               核对 sha256；包里只许 eg.yaml、sp-ca.pem、conv.args 三个普通文件（没有目录 / 链接 / ..），否则删掉并拒绝
#   apply-config <sha256> [force]  核对后后台换配置（同升级任务：state、日志、SSH 断了照跑）：包里 eg.yaml 的子站地址要和接入授权（join.json）一致、
#                               已接入的单元不能变（0.18.0 舱室 EG：比 unit.code，schema 1 退回柜号）—— 例外：拆柜（本机照旧一柜一台接在柜 X，
#                               配置包是 X 的某个单元）、子站带 force（join-egs.sh --force）；和现在的一样就直接答「same」。
#                               失败自动换回旧配置（原来待接入的回到待接入）
#   conv <选项…>                调 install-conv.sh；选项白名单逐个校验（--serial / --sensors / --addr / --dev / --baud / --off / --status），
#                               参数按数组传、不经 shell 拼接
#   drop-tunnel                 撤掉子站 provision 隧道账号 lsa-sp（同 install.sh --drop-sp-key），升级授权留着
# 其它一律拒绝，记进 /var/log/lsa-upg.log。
set -euo pipefail
umask 077
# 4 = 0.18.0 舱室 EG（EG 0.7.0）：hello 报 unit=，apply-config 按单元、认 force
ENTRY_VERSION=4
EG=/opt/lsa-eg
ST=/var/lib/lsa-upg
IN="$ST/incoming"
JOBS="$ST/jobs"
LOG=/var/log/lsa-upg.log
MAX_BYTES=$((8 * 1024 * 1024 * 1024))
CFG_IN="$ST/config-in"
CFG_NEW="$ST/config-new"
MAX_CFG=$((1024 * 1024))

say() { echo "$*"; }
audit() { echo "$(date '+%F %T') $*" >> "$LOG" 2>/dev/null || true; }
deny() { audit "拒绝：${CMD:-（空）} —— $1"; echo "ERR $1"; exit 2; }

[ "$(id -u)" = 0 ] || { echo 'ERR 要经 sudo 调'; exit 1; }
[ $# -le 1 ] || deny '参数只能是一整句命令'
CMD="${1:-}"
[ ${#CMD} -le 400 ] || deny '命令太长'
# conv 的选项另有白名单（下面逐个校验）；其余动作只能是「动词 [sha256] [数字]」
if [[ "$CMD" =~ ^conv(\ |$) ]]; then
  [[ "$CMD" =~ ^conv(\ [A-Za-z0-9/_.,=-]+)*$ ]] || deny 'conv 的参数里有不允许的字符'
  read -r -a CONV_WORDS <<< "$CMD" || true
  VERB=conv A1='' A2=''
else
  [ ${#CMD} -le 200 ] || deny '命令太长'
  [[ "$CMD" =~ ^[a-z][a-z-]*(\ [0-9a-f]{64})?(\ [0-9]{1,12}|\ force)?$ ]] || deny '命令格式不对'
  read -r VERB A1 A2 <<< "$CMD" || true
fi
mkdir -p "$IN" "$JOBS" "$CFG_IN" "$CFG_NEW"
chmod 700 "$ST"

free_bytes() { df -PB1 "$1" | awk 'NR==2 { print $4 }'; }
state_get() { [ -f "$ST/state" ] && sed -n "s/^$1=//p" "$ST/state" | tail -1; }
running() {  # 任务在跑（锁被占着）
  [ -f "$ST/lock" ] || return 1
  ! flock -n "$ST/lock" true
}
is_sha() { [[ "${1:-}" =~ ^[0-9a-f]{64}$ ]]; }
# 这台 EG 正在做的别的维护（子站预检据此跳过，start 遇到安装在跑也拒绝）：一行一项，没有就空
maintenance() {
  # 子站 provision-eg.sh 的隧道开着（在建实体 / 改设备清单）
  # 只认 sshd 会话：账号的 uid 可能和本地库容器（999）撞了，按 uid 一把抓会把本地库的进程当成隧道（0.17.4 修）
  pgrep -u lsa-sp -f '^sshd' >/dev/null 2>&1 && echo 'lsa-sp 隧道开着（子站在建本地实体或改设备清单）'
  # 有人在手工跑安装 / 升级（排除我们自己的升级任务）
  pgrep -af 'install\.sh|lsa9600sp-bundle/setup\.sh|LSA-9600SP-.*\.run' 2>/dev/null | grep -v -e lsa-eg-upgrade -e pgrep | grep -q . && echo '有安装 / 升级在跑（install.sh 或一键安装文件）'
  true
}
# ---- 一键加柜：读 eg.yaml / join.json ----
# 配置文件的指纹：eg.yaml 去掉 generatedAt 那一行再算（子站每次 up.sh 都重新生成、只有它变）；文件不在为 none
cfg_sum() {
  [ -f "$1" ] || { echo none; return 0; }
  case "$1" in *eg.yaml) { grep -v '^generatedAt:' "$1" || true; } | sha256sum | cut -c1-64 ;; *) sha256sum < "$1" | cut -c1-64 ;; esac
}
yaml_sp() { sed -n 's#^  mqtt: *mqtts\{0,1\}://\([^:/]*\).*#\1#p' "$1" 2>/dev/null | head -1 || true; }
yaml_cab() { awk '/^cabinet:/{f=1;next} f&&/^[^ ]/{f=0} f&&$1=="code:"{gsub(/["'\'']/,"",$2);print $2;exit}' "$1" 2>/dev/null || true; }
# 本 EG 的身份（0.18.0 舱室 EG）：eg.yaml 顶层 unit 段的 code；没有（schema 1，照旧一柜一台）= 柜号
yaml_unit() {
  local u
  u="$(awk '/^unit:/{f=1;next} f&&/^[^ ]/{f=0} f&&$1=="code:"{gsub(/["'\'']/,"",$2);print $2;exit}' "$1" 2>/dev/null || true)"
  if [ -n "$u" ]; then echo "$u"; else yaml_cab "$1"; fi
}
yaml_devs() { awk '/^devices:/{f=1;next} f&&/^[^ ]/{f=0} f&&/^  - name:/{gsub(/"/,"",$3);print $3}' "$1" 2>/dev/null || true; }
join_sp() { sed -n 's/.*"sp": *"\([^"]*\)".*/\1/p' "$EG/config/join.json" 2>/dev/null | head -1 || true; }
# conv 选项白名单：conv_parse <eg.yaml> <选项…> → CONV_ARGS；不认的 → CONV_ERR，返回 1
SENS='pd|gas|temperature|arc|infrared'
conv_parse() {
  local egy="$1" v item; shift
  CONV_ARGS=() CONV_ERR=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --serial)
        v="${2:-}"
        [[ "$v" =~ ^/dev/(ttyS[0-9]{1,2}|ttyUSB[0-9]{1,2}|ttyACM[0-9]{1,2}|serial/by-id/[A-Za-z0-9][A-Za-z0-9._-]{0,119})$ ]] || { CONV_ERR="--serial 只认 /dev/ttyS<n>、/dev/ttyUSB<n>、/dev/ttyACM<n>、/dev/serial/by-id/<名字>：$v"; return 1; }
        CONV_ARGS+=(--serial "$v"); shift 2 ;;
      --sensors)
        v="${2:-}"
        [[ "$v" =~ ^($SENS)(,($SENS)){0,4}$ ]] || { CONV_ERR="--sensors 只认 pd / gas / temperature / arc / infrared（逗号分开）：$v"; return 1; }
        CONV_ARGS+=(--sensors "$v"); shift 2 ;;
      --addr)
        v="${2:-}"
        for item in ${v//,/ }; do
          [[ "$item" =~ ^($SENS)=([1-9][0-9]{0,2})$ ]] && [ "${BASH_REMATCH[2]}" -le 247 ] || { CONV_ERR="--addr 要「传感器=1–247」：$item"; return 1; }
        done
        [ -n "$v" ] || { CONV_ERR='--addr 后面没给值'; return 1; }
        CONV_ARGS+=(--addr "$v"); shift 2 ;;
      --dev)
        v="${2:-}"
        [ -n "$v" ] || { CONV_ERR='--dev 后面没给值'; return 1; }
        for item in ${v//,/ }; do
          [[ "$item" =~ ^($SENS)=([A-Za-z0-9-]{1,40})$ ]] || { CONV_ERR="--dev 要「传感器=设备名」：$item"; return 1; }
          yaml_devs "$egy" | grep -qx "${BASH_REMATCH[2]}" || { CONV_ERR="--dev 的设备「${BASH_REMATCH[2]}」不在 eg.yaml 的设备清单里"; return 1; }
        done
        CONV_ARGS+=(--dev "$v"); shift 2 ;;
      --baud)
        v="${2:-}"
        case "$v" in 1200 | 2400 | 4800 | 9600 | 19200 | 38400 | 57600 | 115200) ;; *) CONV_ERR="--baud 只认标准波特率：$v"; return 1 ;; esac
        CONV_ARGS+=(--baud "$v"); shift 2 ;;
      --off | --status) CONV_ARGS+=("$1"); shift ;;
      *) CONV_ERR="不认的选项「$1」（只认 --serial / --sensors / --addr / --dev / --baud / --off / --status）"; return 1 ;;
    esac
  done
}
# 一键安装文件里 EG 发布件的版本（不执行它：只读负载里的 tar）
run_eg_version() {
  local f="$1" skip
  head -c 200 "$f" | head -1 | grep -q '^#!/usr/bin/env bash' || return 1
  skip="$(grep -a -n -m1 '^__LSA_PAYLOAD_BELOW__$' "$f" | cut -d: -f1)" || return 1
  [ -n "$skip" ] || return 1
  tail -n +"$((skip + 1))" "$f" | tar -xO --occurrence=1 lsa9600sp-bundle/eg/VERSION 2>/dev/null | head -1 | tr -d '[:space:]'
}

case "$VERB" in
  hello)
    [ -z "${A1:-}" ] || deny 'hello 不带参数'
    say "entry=$ENTRY_VERSION"
    say "eg_version=$(cat "$EG/VERSION" 2>/dev/null || echo '?')"
    say "free_mb=$(( $(free_bytes "$ST") / 1024 / 1024 ))"
    say "phase=$(state_get phase || true)"
    say "running=$(running && echo 1 || echo 0)"
    say "maint=$(maintenance | awk 'NR > 1 { printf "；" } { printf "%s", $0 }')"
    # 一键加柜：接入了没有、单元号（0.18.0；照旧一柜一台的 = 柜号）、柜号、接的子站（已接入看 eg.yaml，待接入看 join.json）
    if [ -f "$EG/config/eg.yaml" ]; then say 'joined=1'; say "unit=$(yaml_unit "$EG/config/eg.yaml")"; say "cabinet=$(yaml_cab "$EG/config/eg.yaml")"; say "sp=$(yaml_sp "$EG/config/eg.yaml")"
    else say 'joined=0'; say 'unit='; say 'cabinet='; say "sp=$(join_sp)"; fi
    say "join_sp=$(join_sp)"
    ;;
  put)
    is_sha "${A1:-}" && [ -n "${A2:-}" ] || deny 'put <sha256> <字节数>'
    [ "$A2" -gt 0 ] && [ "$A2" -le "$MAX_BYTES" ] || deny '字节数不对'
    running && deny '有升级任务正在跑'
    # 空间：收下的文件 + 解包（同 .run 自己的估算：文件大小 + 512 MB）+ 留 1 GB
    need=$(( A2 * 2 + 1536 * 1024 * 1024 ))
    free="$(free_bytes "$ST")"
    [ "$free" -ge "$need" ] || deny "空间不够：$ST 剩 $((free / 1024 / 1024)) MB，要约 $((need / 1024 / 1024)) MB"
    find "$IN" -maxdepth 1 -type f -delete   # 只留这一份
    part="$IN/.part"
    head -c "$A2" > "$part"
    got="$(stat -c %s "$part")"
    [ "$got" = "$A2" ] || { rm -f "$part"; deny "只收到 $got 字节（应为 $A2）"; }
    sum="$(sha256sum "$part" | cut -d' ' -f1)"
    [ "$sum" = "$A1" ] || { rm -f "$part"; deny "sha256 对不上：收到的是 $sum"; }
    mv "$part" "$IN/$A1.run"
    audit "收到安装文件 $A1（$A2 字节）"
    say "OK put $A1"
    ;;
  start)
    is_sha "${A1:-}" && [ -z "${A2:-}" ] || deny 'start <sha256>'
    f="$IN/$A1.run"
    [ -f "$f" ] || deny "没有收到 $A1 这个安装文件（先 put）"
    running && deny '有升级任务正在跑'
    maintenance | grep -q '安装 / 升级在跑' && deny '这台 EG 上有人在跑安装 / 升级，等它完了再来'
    [ "$(sha256sum "$f" | cut -d' ' -f1)" = "$A1" ] || { rm -f "$f"; deny 'sha256 对不上（文件被改过？已删）'; }
    to="$(run_eg_version "$f" || true)"
    [ -n "$to" ] || deny '不是 LSA-9600 的一键安装文件，或者里面没有 EG 发布件'
    from="$(cat "$EG/VERSION" 2>/dev/null || echo 0)"
    # 只升不降（同版本可以重装）；回退走 install.sh --rollback，不经这里
    [ "$(printf '%s\n%s\n' "${from%%-*}" "${to%%-*}" | sort -V | head -1)" = "${from%%-*}" ] || deny "安装文件里的 EG 是 $to，比现在的 $from 旧：不降级（回退用 install.sh --rollback）"
    job="$(date +%Y%m%d-%H%M%S)"
    printf 'job=%s\nsha=%s\nfrom=%s\nto=%s\nphase=queued\nstarted=%s\nreason=\n' "$job" "$A1" "$from" "$to" "$(date +%s)" > "$ST/state.tmp"
    mv "$ST/state.tmp" "$ST/state"
    : > "$JOBS/$job.log"
    # 脱离 SSH 会话：有 systemd 用 systemd-run（独立的 unit，SSH 断了不受影响），没有就 setsid nohup
    if [ -d /run/systemd/system ] && command -v systemd-run >/dev/null; then
      systemd-run --unit "lsa-eg-upgrade-$job" --collect --quiet /usr/local/sbin/lsa-eg-upgrade-job "$job"
    else
      setsid nohup /usr/local/sbin/lsa-eg-upgrade-job "$job" > /dev/null 2>&1 < /dev/null &
    fi
    audit "开始升级任务 $job：$from → $to（$A1）"
    say "OK start $job $from $to"
    ;;
  status)
    [ -z "${A1:-}" ] || deny 'status 不带参数'
    if [ -f "$ST/state" ]; then cat "$ST/state"; else say 'phase=idle'; fi
    say "running=$(running && echo 1 || echo 0)"
    ;;
  log)
    [ -z "${A2:-}" ] && ! is_sha "${A1:-}" || deny 'log [行数]'
    n="${A1:-50}"
    [[ "$n" =~ ^[0-9]+$ ]] || deny 'log [行数]'
    [ "$n" -le 500 ] || n=500
    job="$(state_get job || true)"
    [ -n "$job" ] && [ -f "$JOBS/$job.log" ] && tail -n "$n" "$JOBS/$job.log" || say '（没有任务日志）'
    ;;
  drop)
    is_sha "${A1:-}" && [ -z "${A2:-}" ] || deny 'drop <sha256>'
    running && [ "$(state_get sha)" = "$A1" ] && deny '这个文件的升级任务正在跑'
    rm -f "$IN/$A1.run"
    audit "删掉安装文件 $A1"
    say "OK drop $A1"
    ;;
  put-config)
    is_sha "${A1:-}" && [ -n "${A2:-}" ] || deny 'put-config <sha256> <字节数>'
    [ "$A2" -gt 0 ] && [ "$A2" -le "$MAX_CFG" ] || deny "配置包不能超过 $MAX_CFG 字节"
    running && deny '有任务正在跑'
    find "$CFG_IN" -maxdepth 1 -type f -delete
    part="$CFG_IN/.part"
    head -c "$A2" > "$part"
    got="$(stat -c %s "$part")"
    [ "$got" = "$A2" ] || { rm -f "$part"; deny "只收到 $got 字节（应为 $A2）"; }
    sum="$(sha256sum "$part" | cut -d' ' -f1)"
    [ "$sum" = "$A1" ] || { rm -f "$part"; deny "配置包 sha256 对不上：收到的是 $sum"; }
    # 包里只许三个普通文件：eg.yaml（必须有）、sp-ca.pem、conv.args
    listing="$(tar -tzvf "$part" 2>/dev/null || true)"
    [ -n "$listing" ] || { rm -f "$part"; deny '不是 tar.gz 配置包'; }
    has_eg=0
    while read -r mode _ _ _ _ name rest; do
      [ -n "${mode:-}" ] || continue
      [ "${mode:0:1}" = - ] && [ -z "${rest:-}" ] || { rm -f "$part"; deny "配置包里有不是普通文件的条目：$name"; }
      case "${name#./}" in
        eg.yaml) has_eg=1 ;;
        sp-ca.pem | conv.args) ;;
        *) rm -f "$part"; deny "配置包里有不认的文件：$name（只许 eg.yaml、sp-ca.pem、conv.args）" ;;
      esac
    done <<< "$listing"
    [ "$has_eg" = 1 ] || { rm -f "$part"; deny '配置包里没有 eg.yaml'; }
    mv "$part" "$CFG_IN/$A1.tgz"; chmod 600 "$CFG_IN/$A1.tgz"
    audit "收到配置包 $A1（$A2 字节）"
    say "OK put-config $A1"
    ;;
  apply-config)
    is_sha "${A1:-}" && { [ -z "${A2:-}" ] || [ "$A2" = force ]; } || deny 'apply-config <sha256> [force]'
    f="$CFG_IN/$A1.tgz"
    [ -f "$f" ] || deny "没有收到 $A1 这个配置包（先 put-config）"
    running && deny '有任务正在跑'
    maintenance | grep -q '安装 / 升级在跑' && deny '这台 EG 上有人在跑安装 / 升级，等它完了再来'
    [ "$(sha256sum "$f" | cut -d' ' -f1)" = "$A1" ] || { rm -f "$f"; deny '配置包 sha256 对不上（被改过？已删）'; }
    d="$CFG_NEW/$A1"; rm -rf "$d"; mkdir -p "$d"
    adeny() { rm -rf "$d"; deny "$@"; }   # 解开以后再拒：解开的目录一起删
    tar -xzf "$f" -C "$d" --no-same-owner --no-same-permissions
    chmod 600 "$d"/*
    new_sp="$(yaml_sp "$d/eg.yaml")"; new_cab="$(yaml_cab "$d/eg.yaml")"; new_unit="$(yaml_unit "$d/eg.yaml")"
    [ -n "$new_sp" ] && [ -n "$new_cab" ] || adeny '配置包里的 eg.yaml 取不到子站地址或柜号'
    # 子站地址要和接入授权一致：有 join.json 认它；老办法接入的（没有 join.json）认现在 eg.yaml 里的
    auth_sp="$(join_sp)"; [ -z "$auth_sp" ] && [ -f "$EG/config/eg.yaml" ] && auth_sp="$(yaml_sp "$EG/config/eg.yaml")"
    [ -n "$auth_sp" ] || adeny '这台 EG 没有接入授权（install.sh --join-key）'
    [ "$new_sp" = "$auth_sp" ] || adeny "配置包是给子站 $new_sp 的，这台 EG 授权的是 $auth_sp"
    if [ -f "$EG/config/eg.yaml" ]; then
      # 已接入的单元不能改（0.18.0 舱室 EG：比单元号，照旧一柜一台的单元号 = 柜号）。例外：
      #   拆柜 —— 本机照旧一柜一台接在柜 X（单元号 = X），配置包是柜 X 的某个单元（X-A…）：原来那台改作这面柜的一个单元；
      #   force —— 子站 join-egs.sh --force（确认要把这台改接到别的单元）
      cur_unit="$(yaml_unit "$EG/config/eg.yaml")"
      if [ "$new_unit" != "$cur_unit" ] && [ "$cur_unit" != "$new_cab" ] && [ "${A2:-}" != force ]; then
        adeny "这台 EG 已接入单元 $cur_unit，配置包是单元 $new_unit 的：不能直接改（确认要改接：子站 join-egs.sh 加 --force）"
      fi
    fi
    # conv.args（可选）：一行一个参数，照 conv 的白名单校验，过了写成 conv.argv 给任务用
    rm -f "$d/conv.argv"
    if [ -f "$d/conv.args" ]; then
      read -r -a cw < "$d/conv.args" || true
      conv_parse "$d/eg.yaml" "${cw[@]}" || adeny "conv.args：$CONV_ERR"
      printf '%s\n' "${CONV_ARGS[@]}" > "$d/conv.argv"
    fi
    # 和现在的配置一样：不用换。eg.yaml 不比 generatedAt 那一行（子站每次 up.sh 都重新生成、只有它变，0.7.1）
    same=1
    for x in eg.yaml sp-ca.pem; do
      a="$(cfg_sum "$d/$x")"; b="$(cfg_sum "$EG/config/$x")"
      [ "$a" = "$b" ] || same=0
    done
    if [ "$same" = 1 ]; then
      rm -rf "$d"
      audit "配置包 $A1 和现在的一样（单元 $new_unit）：不用换"
      say "OK apply-config same $new_unit"
      exit 0
    fi
    job="$(date +%Y%m%d-%H%M%S)"
    printf 'job=%s\nkind=config\nsha=%s\nfrom=%s\nto=%s\nphase=queued\nstarted=%s\nreason=\n' "$job" "$A1" "$(yaml_unit "$EG/config/eg.yaml" || true)" "$new_unit" "$(date +%s)" > "$ST/state.tmp"
    mv "$ST/state.tmp" "$ST/state"
    : > "$JOBS/$job.log"
    if [ -d /run/systemd/system ] && command -v systemd-run >/dev/null; then
      systemd-run --unit "lsa-eg-config-$job" --collect --quiet /usr/local/sbin/lsa-eg-upgrade-job "$job"
    else
      setsid nohup /usr/local/sbin/lsa-eg-upgrade-job "$job" > /dev/null 2>&1 < /dev/null &
    fi
    audit "开始换配置 $job：单元 $new_unit（柜 $new_cab；$A1）${A2:+（force）}"
    say "OK apply-config $job $new_unit"
    ;;
  conv)
    [ -f "$EG/config/eg.yaml" ] || deny '还没接入（没有 eg.yaml）：先 apply-config'
    running && deny '有任务正在跑'
    conv_parse "$EG/config/eg.yaml" "${CONV_WORDS[@]:1}" || deny "$CONV_ERR"
    audit "转换程序：install-conv.sh ${CONV_ARGS[*]}"
    bash "$EG/install-conv.sh" "${CONV_ARGS[@]}" < /dev/null 2>&1 || { echo "ERR install-conv.sh 退出码 $?"; exit 3; }
    ;;
  drop-tunnel)
    [ -z "${A1:-}" ] || deny 'drop-tunnel 不带参数'
    (cd "$EG" && bash install.sh --drop-sp-key < /dev/null 2>&1)
    audit '撤掉 provision 隧道账号 lsa-sp'
    ;;
  *) deny "不认识的命令「$VERB」（只认 hello / put / start / status / log / drop / put-config / apply-config / conv / drop-tunnel）" ;;
esac

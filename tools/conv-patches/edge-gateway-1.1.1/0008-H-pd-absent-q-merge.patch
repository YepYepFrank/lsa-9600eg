地电波 / 特高频读出固定值 187 / 269 时照旧不发读数，另在 q 里标 absent（EG内部MQTT格式 v0.8 §6），
EG 和检查工具据此提示「装置说没装、到子站能力页改成不支持」，不再报「一直没收到」（现场 AH01-B）。
q 每次都发，都装了发 "{}"；判出的没装通道变了记一条 INFO。
app.py 记各路传感器最近一次的 q，发出去的是本设备各路的并集：EG 收到 q 是整体替换，
以前弧光每 2 s 的 "{}" 会把同一设备上别的标记冲掉。
---
 src/core/app.py   | 33 +++++++++++++++++++++++++++++++++
 src/drivers/pd.py | 19 +++++++++++++++++--
 2 files changed, 50 insertions(+), 2 deletions(-)

diff --git a/src/core/app.py b/src/core/app.py
index bd026de..625c783 100644
--- a/src/core/app.py
+++ b/src/core/app.py
@@ -12,6 +12,7 @@
 """
 
 import asyncio
+import json
 import os
 import signal
 import time
@@ -77,6 +78,10 @@ class Application:
         # device_name → {"values": {...}, "ts": int}
         self._device_buffer: Dict[str, Dict[str, Any]] = {}
         self._device_buffer_lock = asyncio.Lock()
+        # 各路传感器最近一次报的 q (补丁 H): 设备名 → {传感器名: (时刻 monotonic, {key: 码})}。同一设备几路的 q 取并集再发:
+        # EG 收到 q 是整体替换, 不合并的话弧光每 2 s 一条 "{}" 会把局放标的 absent / 弧光自己以外的标记冲掉。
+        # 每一路的 q 过了它自己的新鲜窗口就作废 (_q_ttl), 不会被别的传感器的发送带着一直续命
+        self._sensor_q: Dict[str, Dict[str, Any]] = {}
         self._flush_task: Optional[asyncio.Task] = None
         self._buffer_debounce = 0.1  # 100ms 去抖
 
@@ -343,6 +348,9 @@ class Application:
                 self._device_buffer[device] = {"values": {}, "ts": ts, "items": []}
 
             buf = self._device_buffer[device]
+            if "q" in values:
+                values = dict(values)
+                values["q"] = self._merge_q(device, sensor_name, values["q"])
             buf["values"].update(values)
             # ts 取最新的
             if ts > buf["ts"]:
@@ -351,6 +359,31 @@ class Application:
             if normalized is not None:
                 buf["items"].append((sensor_name, normalized))
 
+    def _q_ttl(self, sensor_name: str) -> float:
+        """这一路 q 的新鲜窗口 (秒), 同 EG: max(30 s, 5 个轮询周期) × 2; 周期取 poll_interval, 没配按 priority (fast 2 s / slow 10 s)"""
+        drv = getattr(self, "_drivers", {}).get(sensor_name)
+        period = getattr(drv, "poll_interval", 0) or (2 if getattr(drv, "priority", "slow") == "fast" else 10)
+        return max(30.0, 5.0 * period) * 2
+
+    def _merge_q(self, device: str, sensor_name: str, q: Any) -> str:
+        """记下这路传感器最新的 q, 返回本设备各路 q 的并集 (JSON 串, key 排序)。不是 JSON 对象的当作 {} (补丁 H)。
+        别的路过了自己新鲜窗口的 q 不再算进来, 也从记录里删掉"""
+        try:
+            mine = json.loads(q) if isinstance(q, str) else q
+        except ValueError:
+            mine = None
+        if not isinstance(mine, dict):
+            mine = {}
+        now = time.monotonic()
+        per = self._sensor_q.setdefault(device, {})
+        per[sensor_name] = (now, {str(k): str(v) for k, v in mine.items()})
+        for name in [n for n, (at, _) in per.items() if now - at > self._q_ttl(n)]:
+            del per[name]
+        merged: Dict[str, str] = {}
+        for _, d in per.values():
+            merged.update(d)
+        return json.dumps(dict(sorted(merged.items())), ensure_ascii=False)
+
     async def _flush_device_buffer_loop(self) -> None:
         """
         后台任务: 定期刷新设备缓冲区
diff --git a/src/drivers/pd.py b/src/drivers/pd.py
index e63263b..cad3fe2 100644
--- a/src/drivers/pd.py
+++ b/src/drivers/pd.py
@@ -24,8 +24,12 @@ v0.7 要点:
     - 轮询周期 3s (装置 3s 刷新一次)
     - 没装的通道读出固定值: 地电波=187, 特高频=269 → 不发
     - 50/100Hz 分量、告警阈值首期不发
+
+v0.8 (EG 补丁 H): 没装的通道照旧不发读数, 另在 q 里标 absent (如 {"tev.amp": "absent", "tev.level": "absent"}),
+    让 EG 和检查工具知道是「装置说没装」而不是「读不到」; 每次都发 q, 通道都装了发 "{}"
 """
 
+import json
 from typing import Any, Dict, Optional
 from src.drivers.base import SensorDriver
 from src.drivers.modbus_rtu import ModbusRTUClient
@@ -44,6 +48,7 @@ class PartialDischargeDriver(SensorDriver):
     def __init__(self, modbus_client: ModbusRTUClient, config: Dict[str, Any]):
         super().__init__(modbus_client, config)
         self._registers = config.get("registers", {})
+        self._absent: Optional[frozenset] = None  # 上次判出的没装通道 (变了才记 INFO 日志)
 
     async def read_raw(self) -> Optional[Dict[str, Any]]:
         """连续读取 14 个寄存器 (0x0000~0x000D), 覆盖三个通道"""
@@ -85,13 +90,15 @@ class PartialDischargeDriver(SensorDriver):
         result["us.type"] = raw_data["us_type_raw"]                 # 可选
         result["us.level"] = raw_data["us_level_raw"]               # 可选
 
+        q: Dict[str, str] = {}  # 补丁 H: 没装的通道标 absent
+
         # ── 地电波 TEV 通道 (本柜装了才发) ──
         tev_raw = raw_data["tev_amp_raw"]
         if tev_raw != _TEV_INVALID:
             result["tev.amp"] = round(tev_raw * 0.1, 1)            # dBmV
             result["tev.level"] = raw_data["tev_level_raw"]        # 可选
         else:
-            logger.debug("地电波通道未安装 (raw=%d), 不发", tev_raw)
+            q["tev.amp"] = q["tev.level"] = "absent"
 
         # ── 特高频 UHF 通道 (本柜装了才发) ──
         uhf_raw = raw_data["uhf_amp_raw"]
@@ -99,6 +106,14 @@ class PartialDischargeDriver(SensorDriver):
             result["uhf.amp"] = round(uhf_raw * 0.1, 1)            # dBmV
             result["uhf.level"] = raw_data["uhf_level_raw"]        # 可选
         else:
-            logger.debug("特高频通道未安装 (raw=%d), 不发", uhf_raw)
+            q["uhf.amp"] = q["uhf.level"] = "absent"
+
+        result["q"] = json.dumps(q, ensure_ascii=False)
+        absent = frozenset(k.split(".")[0] for k in q)
+        if absent != self._absent:
+            names = [n for c, n in (("tev", "地电波(寄存器 6 = 187)"), ("uhf", "特高频(寄存器 10 = 269)")) if c in absent]
+            logger.info("局放 slave=%d: %s", self._slave_id,
+                        ("没装的通道: %s, 不发读数、q 标 absent" % "、".join(names)) if names else "地电波、特高频通道都装了")
+            self._absent = absent
 
         return result

一台总线上 clientId 重复会互相踢下线。eg.yaml 由 EG 只读挂进容器（环境变量 LSA_EG_YAML 可改路径）。第 3 轮联调意见第二部分 A。
---
 src/north/mqtt_client.py | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/src/north/mqtt_client.py b/src/north/mqtt_client.py
index 30479da..5f477c0 100644
--- a/src/north/mqtt_client.py
+++ b/src/north/mqtt_client.py
@@ -6,6 +6,7 @@
 
 import asyncio
 import json
+import os
 from typing import Any, Callable, Dict, Optional
 import aiomqtt
 from src.core.logger import setup_logger
@@ -13,6 +14,19 @@ from src.core.logger import setup_logger
 logger = setup_logger("mqtt_client")
 
 
+def _client_id_from_eg_yaml() -> Optional[str]:
+    """clientId 用 lsa-conv-<柜号>：柜号取 EG 只读挂进来的 eg.yaml 的 cabinet.code（LSA_EG_YAML，缺省 /eg/eg.yaml）。
+    取不到返回 None，由调用方用配置里的 client_id。一台总线上 clientId 重复会互相踢下线"""
+    path = os.environ.get("LSA_EG_YAML", "/eg/eg.yaml")
+    try:
+        import yaml
+        with open(path, encoding="utf-8") as f:
+            code = ((yaml.safe_load(f) or {}).get("cabinet") or {}).get("code")
+        return f"lsa-conv-{code}" if code else None
+    except Exception:
+        return None
+
+
 class InternalMQTTClient:
     """
     EG 内部 MQTT 客户端
@@ -34,7 +48,7 @@ class InternalMQTTClient:
         self._port = mqtt_config.get("port", 1884)
         self._username = mqtt_config.get("username", "")
         self._password = mqtt_config.get("password", "")
-        self._client_id = mqtt_config.get("client_id", "lsa-conv-eg")
+        self._client_id = _client_id_from_eg_yaml() or mqtt_config.get("client_id", "lsa-conv-eg")
         self._keepalive = mqtt_config.get("keepalive", 30)
         self._qos = mqtt_config.get("qos", 1)
         self._reconnect_interval = mqtt_config.get("reconnect_interval", 3)

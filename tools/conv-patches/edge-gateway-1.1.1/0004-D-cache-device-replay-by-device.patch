         values_json: str,
         quality: str = "GOOD",
+        device: Optional[str] = None,
     ) -> int:
         """
         插入一条遥测缓存记录
@@ -74,8 +98,8 @@ class DatabaseManager:
             await self.initialize()
 
         cursor = await self._db.execute(
-            "INSERT INTO telemetry_cache (ts, sensor_name, values_json, quality) VALUES (?, ?, ?, ?)",
-            (ts, sensor_name, values_json, quality),
+            "INSERT INTO telemetry_cache (ts, sensor_name, values_json, quality, device) VALUES (?, ?, ?, ?, ?)",
+            (ts, sensor_name, values_json, quality, device),
         )
         await self._db.commit()
         return cursor.lastrowid
@@ -91,7 +115,7 @@ class DatabaseManager:
             return []
 
         cursor = await self._db.execute(
-            "SELECT id, ts, sensor_name, values_json, quality FROM telemetry_cache ORDER BY ts ASC LIMIT ?",
+            "SELECT id, ts, sensor_name, values_json, quality, device FROM telemetry_cache ORDER BY ts ASC LIMIT ?",
             (limit,),
         )
         rows = await cursor.fetchall()
@@ -102,6 +126,7 @@ class DatabaseManager:
                 "sensor_name": row[2],
                 "values_json": row[3],
                 "quality": row[4],
+                "device": row[5],
             }
             for row in rows
         ]
diff --git a/src/storage/replay.py b/src/storage/replay.py
index 7acbfff..8c132d8 100644
--- a/src/storage/replay.py
+++ b/src/storage/replay.py
@@ -67,28 +67,26 @@ class DataReplayer:
         if not records:
             return
 
-        # 构造批量发送数据
-        batch = []
-        ids_to_delete = []
+        # 按设备名分组 (各发到自己的 lsa/<设备名>/telemetry; 没有设备名的老记录发到缺省设备名)
+        groups: Dict[str, Dict[str, list]] = {}
         for record in records:
             try:
                 values = json.loads(record["values_json"])
-                batch.append({
+                g = groups.setdefault(record.get("device") or mqtt_client.device_name, {"batch": [], "ids": []})
+                g["batch"].append({
                     "ts": record["ts"],
                     "values": values,
                 })
-                ids_to_delete.append(record["id"])
+                g["ids"].append(record["id"])
             except Exception as e:
                 logger.warning("解析缓存记录失败: id=%d, err=%s", record["id"], e)
 
-        if not batch:
-            return
-
-        # 批量发送
-        success = await mqtt_client.publish_telemetry_batch(batch)
-        if success:
-            # 发送成功后删除记录
-            await self._db.delete_by_ids(ids_to_delete)
-            logger.info("补传成功: 发送 %d 条, 删除 %d 条", len(batch), len(ids_to_delete))
-        else:
-            logger.warning("补传发送失败, 等待下次重试")
+        # 批量发送: 每个设备一批, 发成功的才删
+        for device, g in groups.items():
+            success = await mqtt_client.publish_telemetry_batch(g["batch"], device)
+            if success:
+                await self._db.delete_by_ids(g["ids"])
+                logger.info("补传成功: device=%s, 发送 %d 条", device, len(g["batch"]))
+            else:
+                logger.warning("补传发送失败, 等待下次重试")
+                break

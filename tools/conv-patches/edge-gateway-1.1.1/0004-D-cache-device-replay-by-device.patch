diff --git a/src/storage/db.py b/src/storage/db.py
index b20ba43..71a09cd 100644
--- a/src/storage/db.py
+++ b/src/storage/db.py
@@ -18,7 +18,8 @@ CREATE TABLE IF NOT EXISTS telemetry_cache (
     sensor_name TEXT NOT NULL,        -- 传感器名称
     values_json TEXT NOT NULL,        -- JSON 格式的遥测值
     quality TEXT DEFAULT 'GOOD',      -- 数据质量码
-    created_at INTEGER DEFAULT (strftime('%s', 'now') * 1000)
+    created_at INTEGER DEFAULT (strftime('%s', 'now') * 1000),
+    device TEXT                       -- 设备名 (补传按它发到 lsa/<设备名>/telemetry)
 );
 
 CREATE INDEX IF NOT EXISTS idx_ts ON telemetry_cache(ts);
@@ -47,9 +48,31 @@ class DatabaseManager:
 
         self._db = await aiosqlite.connect(self._db_path)
         await self._db.executescript(CREATE_TABLE_SQL)
+        # 老库没有 device 列: 补上 (老记录先是空, 由 backfill_device 按「传感器 → 设备」回填)
+        cursor = await self._db.execute("PRAGMA table_info(telemetry_cache)")
+        if "device" not in [row[1] for row in await cursor.fetchall()]:
+            await self._db.execute("ALTER TABLE telemetry_cache ADD COLUMN device TEXT")
+            logger.info("缓存表补上 device 列 (老库迁移)")
         await self._db.commit()
         logger.info("数据库初始化完成: %s", self._db_path)
 
+    async def backfill_device(self, sensor_devices: Dict[str, str]) -> None:
+        """老记录没有设备名的, 按「传感器 → 设备」回填 (配置里查不到的传感器保持空, 补传时发到缺省设备名)"""
+        if not self._db:
+            return
+        n = 0
+        for sensor_name, device in sensor_devices.items():
+            if not device:
+                continue
+            cursor = await self._db.execute(
+                "UPDATE telemetry_cache SET device = ? WHERE device IS NULL AND sensor_name = ?",
+                (device, sensor_name),
+            )
+            n += cursor.rowcount
+        await self._db.commit()
+        if n:
+            logger.info("缓存老记录回填设备名: %d 条", n)
+
     async def close(self) -> None:
         """关闭数据库连接"""
         if self._db:
@@ -63,6 +86,7 @@ class DatabaseManager:

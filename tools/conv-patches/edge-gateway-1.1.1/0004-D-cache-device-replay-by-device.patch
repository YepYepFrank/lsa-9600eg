                     logger.warning("MQTT 首次连接失败, 将在后台重连")
 
-            # 初始化数据库
+            # 初始化数据库 (老库补 device 列, 老记录按「传感器 → 设备」回填)
             if self._db:
                 await self._db.initialize()
+                await self._db.backfill_device({
+                    name: c.get("sensor", {}).get("device")
+                    for name, c in self._config.get_enabled_sensors().items()})
 
             # 启动后台任务
             self._running = True
@@ -282,7 +285,7 @@ class Application:
             published = await self._mqtt.publish_telemetry_to(device, event_ts, values)
     
         if not published and self._cache:
-            await self._cache.save(sensor_name, {"ts": event_ts, "values": values})
+            await self._cache.save(sensor_name, {"ts": event_ts, "values": values}, device)
 
     # ── 数据回调: 设备级合并 ───────────────────────────────────
 
@@ -387,7 +390,7 @@ class Application:
                 # 只有发布失败才进缓存 (避免数据发两遍)
                 if self._cache:
                     for sensor_name, normalized in items:
-                        await self._cache.save(sensor_name, normalized)
+                        await self._cache.save(sensor_name, normalized, device)
 
     # ── 后台任务管理 ───────────────────────────────────────────
 
@@ -461,7 +464,7 @@ class Application:
                 # 没连上或发布失败都进缓存（下次启动补传）
                 if not ok and self._cache:
                     for sensor_name, normalized in buf.get("items", []):
-                        await self._cache.save(sensor_name, normalized)
+                        await self._cache.save(sensor_name, normalized, device)
                         n += 1
             self._device_buffer.clear()
             if n:

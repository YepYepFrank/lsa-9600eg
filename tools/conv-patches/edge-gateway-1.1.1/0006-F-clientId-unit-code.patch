0.18.0 起一个电气舱室一台 EG：同一面柜的两台 EG 各跑一个转换程序，各连自己本机的总线。
clientId 按单元号区分，日志里一眼看出是哪个舱室；照旧一柜一台的 eg.yaml 没有 unit 段，仍是 lsa-conv-<柜号>，与以前一样。
---
 src/north/mqtt_client.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/north/mqtt_client.py b/src/north/mqtt_client.py
index 20a4e56..595a0f9 100644
--- a/src/north/mqtt_client.py
+++ b/src/north/mqtt_client.py
@@ -15,13 +15,15 @@ logger = setup_logger("mqtt_client")
 
 
 def _client_id_from_eg_yaml() -> Optional[str]:
-    """clientId 用 lsa-conv-<柜号>：柜号取 EG 只读挂进来的 eg.yaml 的 cabinet.code（LSA_EG_YAML，缺省 /eg/eg.yaml）。
+    """clientId 用 lsa-conv-<单元号>：取 EG 只读挂进来的 eg.yaml（LSA_EG_YAML，缺省 /eg/eg.yaml）。
+    单元号先取顶层 unit.code（一个电气舱室一台 EG，如 AH01-A），没有（照旧一柜一台）取 cabinet.code（如 AH03）。
     取不到返回 None，由调用方用配置里的 client_id。一台总线上 clientId 重复会互相踢下线"""
     path = os.environ.get("LSA_EG_YAML", "/eg/eg.yaml")
     try:
         import yaml
         with open(path, encoding="utf-8") as f:
-            code = ((yaml.safe_load(f) or {}).get("cabinet") or {}).get("code")
+            doc = yaml.safe_load(f) or {}
+        code = (doc.get("unit") or {}).get("code") or (doc.get("cabinet") or {}).get("code")
         return f"lsa-conv-{code}" if code else None
     except Exception:
         return None

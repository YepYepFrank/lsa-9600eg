diff --git a/src/drivers/meter.py b/src/drivers/meter.py
new file mode 100644
index 0000000..6311173
--- /dev/null
+++ b/src/drivers/meter.py
@@ -0,0 +1,133 @@
+"""
+多功能电表驱动（通用 Modbus 寄存器表，LSA 补丁 0007-G）
+对应 EG内部MQTT格式 §5.2：发 el.*，一律二次值 —— 表计读多少发多少，不乘 PT / CT（EG 上送前按子站下发的变比换成一次值）。
+
+不写死型号：读哪几段寄存器（blocks）、每个量在哪个地址、什么数据类型、字序、倍率，全在 config/sensors/meter.yaml。
+型号定了只换那张表，不改程序。
+  - blocks：一次读一段连续寄存器（≤ 125 个）；every 秒数 = 这段多久读一次（谐波这类分钟档的量），0 / 不写 = 每次轮询都读
+  - registers：key（照点目录 el.*）→ { address, type, scale, count, json, ratio }
+      type   uint16 / int16 / uint32 / int32 / float32（32 位按 word_order 拼：big = 高字在前，little = 低字在前）
+      scale  倍率（原始值 × scale），缺省 1
+      count  连读几个同类型的值（谐波含有率 30 个），json: true 时发成 JSON 字符串数组
+      ratio  pt / ct / ptct：表计内部设了变比、读出来已是一次值时，按配置里 ratio.pt / ratio.ct 除回二次值
+  - 一段读失败：这一轮整台电表算失败（dev.fails 往上数），不发半截数
+和 SAM 的 5 路共用同一个 ModbusRTUClient（同一条总线、同一把锁、同一个轮询循环），不另开串口。
+"""
+
+import json
+import struct
+import time
+from typing import Any, Dict, List, Optional, Tuple
+
+from src.core.logger import setup_logger
+from src.drivers.base import SensorDriver
+from src.drivers.modbus_rtu import ModbusRTUClient
+
+logger = setup_logger("driver.meter")
+
+WORDS = {"uint16": 1, "int16": 1, "uint32": 2, "int32": 2, "float32": 2}
+MAX_BLOCK = 125  # Modbus 一次最多读 125 个寄存器
+
+
+class ModbusMeterDriver(SensorDriver):
+    """通用 Modbus 多功能电表（按寄存器表读）"""
+
+    def __init__(self, modbus_client: ModbusRTUClient, config: Dict[str, Any]):
+        super().__init__(modbus_client, config)
+        self._fc = int(config.get("function", 3))
+        self._big = str(config.get("word_order", "big")).lower() != "little"
+        ratio = config.get("ratio") or {}
+        self._pt = float(ratio.get("pt", 1) or 1)
+        self._ct = float(ratio.get("ct", 1) or 1)
+        self._blocks: List[Dict[str, int]] = []
+        for b in config.get("blocks") or []:
+            addr, cnt = int(b.get("address", 0)), int(b.get("count", 0))
+            if cnt < 1 or cnt > MAX_BLOCK:
+                logger.error("电表寄存器段 0x%04X 长度 %d 不对（1–%d），跳过", addr, cnt, MAX_BLOCK)
+                continue
+            self._blocks.append({"address": addr, "count": cnt, "every": int(b.get("every", 0) or 0)})
+        self._regs: Dict[str, Dict[str, Any]] = {}
+        for key, spec in (config.get("registers") or {}).items():
+            err = self._check(key, spec or {})
+            if err:
+                logger.error("电表寄存器 %s：%s，跳过", key, err)
+                continue
+            self._regs[key] = spec
+        self._last_read: Dict[int, float] = {}
+        if self._fc not in (3, 4):
+            logger.error("电表功能码 %s 不对（只认 3 / 4），按 3 读", self._fc)
+            self._fc = 3
+        logger.info("电表：从站 %d，FC%02d，%d 段寄存器、%d 个量，字序 %s，表内变比 PT %g / CT %g",
+                    self._slave_id, self._fc, len(self._blocks), len(self._regs),
+                    "高字在前" if self._big else "低字在前", self._pt, self._ct)
+
+    def _span(self, spec: Dict[str, Any]) -> Tuple[int, int]:
+        """寄存器占的地址范围 [起, 止)"""
+        start = int(spec.get("address", -1))
+        return start, start + WORDS.get(str(spec.get("type", "")), 0) * int(spec.get("count", 1) or 1)
+
+    def _check(self, key: str, spec: Dict[str, Any]) -> str:
+        if str(spec.get("type", "")) not in WORDS:
+            return "type「%s」不认识（可用：%s）" % (spec.get("type"), " / ".join(WORDS))
+        if spec.get("ratio") not in (None, "", "pt", "ct", "ptct"):
+            return "ratio「%s」不认识（pt / ct / ptct）" % spec.get("ratio")
+        start, end = self._span(spec)
+        if start < 0:
+            return "没有 address"
+        if not any(b["address"] <= start and end <= b["address"] + b["count"] for b in self._blocks):
+            return "地址 0x%04X–0x%04X 不在任何一段 blocks 里" % (start, end - 1)
+        return ""
+
+    async def read_raw(self) -> Optional[Dict[str, Any]]:
+        now = time.monotonic()
+        words: Dict[int, int] = {}
+        for i, b in enumerate(self._blocks):
+            if b["every"] and now - self._last_read.get(i, -1e12) < b["every"]:
+                continue  # 慢档的这一段还没到时候
+            read = self._client.read_input_registers if self._fc == 4 else self._client.read_holding_registers
+            regs = await read(slave_id=self._slave_id, address=b["address"], count=b["count"])
+            if regs is None or len(regs) < b["count"]:
+                logger.warning("读电表失败: slave=%d, 段 0x%04X×%d", self._slave_id, b["address"], b["count"])
+                return None
+            self._last_read[i] = now
+            for j, v in enumerate(regs):
+                words[b["address"] + j] = v
+        return {"words": words}
+
+    def _value(self, words: Dict[int, int], addr: int, typ: str) -> Optional[float]:
+        if WORDS[typ] == 1:
+            w = words.get(addr)
+            if w is None:
+                return None
+            return w - 0x10000 if typ == "int16" and w > 0x7FFF else w
+        hi, lo = words.get(addr), words.get(addr + 1)
+        if hi is None or lo is None:
+            return None
+        if not self._big:
+            hi, lo = lo, hi
+        raw = struct.pack(">HH", hi & 0xFFFF, lo & 0xFFFF)
+        return struct.unpack(">f" if typ == "float32" else (">i" if typ == "int32" else ">I"), raw)[0]
+
+    def _div(self, spec: Dict[str, Any]) -> float:
+        r = spec.get("ratio")
+        return {"pt": self._pt, "ct": self._ct, "ptct": self._pt * self._ct}.get(r, 1.0) if r else 1.0
+
+    def parse(self, raw_data: Dict[str, Any]) -> Dict[str, Any]:
+        words = raw_data.get("words") or {}
+        out: Dict[str, Any] = {}
+        for key, spec in self._regs.items():
+            typ = str(spec["type"])
+            start, _ = self._span(spec)
+            if start not in words:
+                continue  # 这一段这轮没读（慢档）
+            scale = float(spec.get("scale", 1) or 1) / self._div(spec)
+            n = int(spec.get("count", 1) or 1)
+            vals = [self._value(words, start + i * WORDS[typ], typ) for i in range(n)]
+            if any(v is None for v in vals):
+                continue
+            nums = [round(v * scale, 4) for v in vals]  # type: ignore[operator]
+            if any(x != x or x in (float("inf"), float("-inf")) for x in nums):
+                logger.warning("电表 %s 读出非数（NaN / Inf），这一轮不发", key)
+                continue
+            out[key] = json.dumps(nums) if spec.get("json") or n > 1 else nums[0]
+        return out
-- 

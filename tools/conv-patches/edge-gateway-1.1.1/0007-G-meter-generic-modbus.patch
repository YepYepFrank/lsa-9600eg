diff --git a/config/sensors/meter.yaml b/config/sensors/meter.yaml
new file mode 100644
index 0000000..f55836b
--- /dev/null
+++ b/config/sensors/meter.yaml
@@ -0,0 +1,55 @@
+# 多功能电表配置（通用 Modbus 寄存器表驱动 src/drivers/meter.py，LSA 补丁 0007-G）
+# 对应 EG内部MQTT格式 §5.2：发 el.*，一律二次值 —— 表计读多少发多少，不乘 PT / CT（EG 上送前按子站下发的变比换成一次值）
+#
+# !! 下面的寄存器表是「占位」：S19 电表型号 / 点表还没定（2026-10-19）。先按一种常见布局写好，让框架和模拟器自检跑起来；
+#    型号定了照表计手册改 function / word_order / blocks / registers 这几段，程序不用改。
+#
+# 跟 SAM 的 5 路传感器同一条 485 总线（COM2，9600 8N1）、同一个轮询循环；从站地址 6（S19 约定）。
+# 只在 eg.yaml 里有这面柜电表（PM-<柜号>）的那台 EG 上打开 —— EG 的 install-conv.sh 按 eg.yaml 自动开关、填设备名。
+
+sensor:
+  name: "meter"
+  type: "modbus_meter"
+  device: "PM-AH03"            # 设备名 (与 eg.yaml 一致)
+  slave_id: 6                  # Modbus 从站地址
+  priority: "fast"             # 电量走快档（EG内部MQTT格式 §5.2「快」）
+  enabled: false
+
+# ── 读法 ──────────────────────────────────────────────────
+function: 3                    # 03 = 读保持寄存器，04 = 读输入寄存器（看表计手册）
+word_order: "big"              # 32 位数两个字的顺序：big = 高字在前（ABCD），little = 低字在前（CDAB）
+ratio:                         # 表计内部设了变比、读出来已是一次值时才填（程序按 registers 里的 ratio 除回二次值）；读出来就是二次值保持 1
+  pt: 1
+  ct: 1
+
+# ── 寄存器段：一次读一段连续寄存器（每段 ≤ 125 个）──────────
+# every = 这段多久读一次（秒）；不写 = 每次轮询都读
+blocks:
+  - { address: 0x0000, count: 28 }               # 电压、电流、功率、功率因数、频率、THD、电能
+  - { address: 0x0100, count: 90, every: 60 }    # 电压谐波含有率 A/B/C 各 2–31 次（分钟档）
+  - { address: 0x0200, count: 90, every: 60 }    # 电流谐波含有率 A/B/C 各 2–31 次（分钟档）
+
+# ── 寄存器表：key 照点目录 el.* ─────────────────────────────
+# type：uint16 / int16 / uint32 / int32 / float32；scale：原始值 × scale；count + json：连读几个、发成 JSON 字符串数组
+# ratio：pt / ct / ptct —— 只在上面 ratio 不是 1 时起作用
+registers:
+  el.Ua:   { address: 0x0000, type: float32, ratio: pt }      # 相电压 V
+  el.Ub:   { address: 0x0002, type: float32, ratio: pt }
+  el.Uc:   { address: 0x0004, type: float32, ratio: pt }
+  el.Ia:   { address: 0x0006, type: float32, ratio: ct }      # 相电流 A
+  el.Ib:   { address: 0x0008, type: float32, ratio: ct }
+  el.Ic:   { address: 0x000A, type: float32, ratio: ct }
+  el.P:    { address: 0x000C, type: float32, ratio: ptct }    # 有功功率 kW
+  el.Q:    { address: 0x000E, type: float32, ratio: ptct }    # 无功功率 kvar
+  el.S:    { address: 0x0010, type: float32, ratio: ptct }    # 视在功率 kVA
+  el.PF:   { address: 0x0012, type: float32 }                 # 功率因数
+  el.F:    { address: 0x0014, type: float32 }                 # 频率 Hz
+  el.THDu: { address: 0x0016, type: float32 }                 # 电压总谐波畸变率 %
+  el.THDi: { address: 0x0018, type: float32 }                 # 电流总谐波畸变率 %
+  el.Ep:   { address: 0x001A, type: uint32, scale: 0.01, ratio: ptct }   # 正向有功电能 kWh（累计，必须单调不减）
+  el.hu.A: { address: 0x0100, type: uint16, count: 30, scale: 0.01, json: true }   # 电压 2–31 次谐波含有率 %
+  el.hu.B: { address: 0x011E, type: uint16, count: 30, scale: 0.01, json: true }
+  el.hu.C: { address: 0x013C, type: uint16, count: 30, scale: 0.01, json: true }
+  el.hi.A: { address: 0x0200, type: uint16, count: 30, scale: 0.01, json: true }   # 电流 2–31 次谐波含有率 %
+  el.hi.B: { address: 0x021E, type: uint16, count: 30, scale: 0.01, json: true }
+  el.hi.C: { address: 0x023C, type: uint16, count: 30, scale: 0.01, json: true }
